generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum ExpenseCategory {
  MATERIA_PRIMA
  DIESEL
  PLANILLA
  REPUESTOS
  MANTENIMIENTO
  TRANSPORTE
  LUZ
  COMIDA
  VARIOS
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole
  expenses     Expense[]
  incomes      Income[]
  productions  Production[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Employee {
  id           String              @id @default(cuid())
  name         String
  roleLabel    String?
  dailySalary  Decimal             @default(0) @db.Decimal(10, 2)
  isActive     Boolean             @default(true)
  payrollLines ExpensePayrollLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([name])
  @@index([isActive])
}

model Product {
  id          String       @id @default(cuid())
  name        String
  unitType    String       @default("Sacks of 100 lbs")
  incomes     Income[]
  incomeLines IncomeLine[]
  productions Production[]
  inventory   Inventory?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  rtn       String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  incomes   Income[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  payrollLines ExpensePayrollLine[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

model ExpensePayrollLine {
  id           String    @id @default(cuid())
  expenseId     String
  expense       Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  employeeName  String
  workDays      Decimal?  @db.Decimal(8, 2)
  dailySalary   Decimal?  @db.Decimal(12, 2)
  bonuses       Decimal?  @db.Decimal(12, 2)
  deductions    Decimal?  @db.Decimal(12, 2)
  amount        Decimal   @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([expenseId])
  @@index([employeeId])
}

model Income {
  id           String    @id @default(cuid())
  date         DateTime
  referenceCode String?
  sourceApp    String?
  invoiceNumber String?
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Decimal   @db.Decimal(12, 2)
  pricePerUnit Decimal   @db.Decimal(12, 2)
  total        Decimal   @db.Decimal(12, 2)
  amountPaid   Decimal   @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  paymentNotes String?
  comprobanteUrl String?
  clientName   String
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  lines        IncomeLine[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([date])
  @@index([clientId])
  @@index([productId])
}

model IncomeLine {
  id           String   @id @default(cuid())
  incomeId     String
  income       Income   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @db.Decimal(12, 2)
  pricePerUnit Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([incomeId])
  @@index([productId])
}

model Production {
  id          String    @id @default(cuid())
  date        DateTime
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(12, 2)
  notes       String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  shiftId     String?
  shift       Shift?    @relation(fields: [shiftId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([productId])
  @@index([shiftId])
}

model Inventory {
  id          String    @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @db.Decimal(12, 2)
  lastUpdated  DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Machine {
  id          String        @id @default(cuid())
  name        String        @unique
  type        String
  logs        MachineLog[]
  maintenance Maintenance[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MachineLog {
  id         String   @id @default(cuid())
  machineId  String
  machine    Machine  @relation(fields: [machineId], references: [id])
  date       DateTime
  hoursUsed  Decimal  @db.Decimal(10, 2)
  dieselUsed Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@index([machineId])
}

model Shift {
  id          String       @id @default(cuid())
  name        String       @unique
  startTime   String
  endTime     String
  productions Production[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Maintenance {
  id         String          @id @default(cuid())
  machineId  String
  machine    Machine         @relation(fields: [machineId], references: [id])
  date       DateTime
  type       MaintenanceType
  cost       Decimal         @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([date])
  @@index([machineId])
}
